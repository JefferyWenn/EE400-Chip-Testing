diff --git a/hammer-cadence-plugins/formal/conformal/__init__.py b/hammer-cadence-plugins/formal/conformal/__init__.py
index 7e53c2b..fc9c155 100755
--- a/hammer-cadence-plugins/formal/conformal/__init__.py
+++ b/hammer-cadence-plugins/formal/conformal/__init__.py
@@ -240,6 +240,13 @@ class Conformal(HammerFormalTool, CadenceTool):
             append(f'add_pin_constraints 0 {{{pin}}} -golden')
             append(f'add_pin_constraints 0 {{{pin}}} -revised')
 
+        # Ignore DFT-only outputs (e.g. scan_out) that exist solely after scan
+        # insertion: they are undriven in RTL but driven by the Genus-stitched
+        # scan chain in the netlist, so LEC can never map them. Functionally
+        # inert (scan correctness is verified by ATPG), so waiving is safe.
+        for pin in self.get_setting("formal.inputs.ignored_outputs", nullvalue=[]):
+            append(f'add_ignored_outputs {{{pin}}} -both')
+
         if self.get_setting("formal.conformal.license") == "L":
             append("report_black_box")
             append("set_system_mode lec")
diff --git a/hammer-cadence-plugins/par/innovus/__init__.py b/hammer-cadence-plugins/par/innovus/__init__.py
index 70d30b9..476a402 100755
--- a/hammer-cadence-plugins/par/innovus/__init__.py
+++ b/hammer-cadence-plugins/par/innovus/__init__.py
@@ -158,6 +158,17 @@ class Innovus(HammerPlaceAndRouteTool, CadenceTool):
     def env_vars(self) -> Dict[str, str]:
         v = dict(super().env_vars)
         v["INNOVUS_BIN"] = self.get_setting("par.innovus.innovus_bin")
+        # Innovus's Critical Region Resynthesis (place_opt / route_opt) shells
+        # out to `genus` by name. If it isn't on PATH, Innovus prints
+        # "IMPOPT: Genus executable not found in PATH" and disables CRR, which
+        # degrades timing/QoR. Put the Genus bin dir (same install synthesis
+        # uses) on PATH so CRR runs. Derived from cadence.cadence_home +
+        # synthesis.genus.version, identical to the genus plugin's genus_bin.
+        genus_dir = os.path.join(
+            self.get_setting("cadence.cadence_home"),
+            "GENUS", "GENUS{}".format(self.get_setting("synthesis.genus.version")),
+            "bin")
+        v["PATH"] = genus_dir + os.pathsep + os.environ.get("PATH", "")
         return v
 
     @property
