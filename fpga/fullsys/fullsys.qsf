set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
# ---- Pull-ups: I2C lines to the glove (like resistors on a real board), ADC MISO ----
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[34]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[35]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[27]
