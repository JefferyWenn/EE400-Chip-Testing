# fullsys.qsf - full-system emulation on ONE DE1-SoC (driver + chip, loopback wires JP1 <-> JP2)

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY fullsys_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name SEARCH_PATH ../chip/rtl/basejump
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE fullsys.sdc

# ---- Source files ----
set_global_assignment -name VERILOG_FILE fullsys_top.v
set_global_assignment -name VERILOG_FILE i2c_monitor.v
# driver
set_global_assignment -name VERILOG_FILE ../driver/driver_top.v
set_global_assignment -name VERILOG_FILE ../driver/reset_seq.v
set_global_assignment -name VERILOG_FILE ../driver/uart_host.v
set_global_assignment -name VERILOG_FILE ../driver/fake_adc.v
set_global_assignment -name VERILOG_FILE ../driver/fake_cnn.v
set_global_assignment -name VERILOG_FILE ../driver/hex7seg.v
set_global_assignment -name VERILOG_FILE ../driver/status.v
# chip board top + FPGA stand-ins for TSMC cells
set_global_assignment -name VERILOG_FILE ../chip/chip_fpga_top.v
set_global_assignment -name VERILOG_FILE ../chip/chip_leds.v
set_global_assignment -name VERILOG_FILE ../common/tsmc_fpga_models.v
# chip RTL (final Jun 6 version)
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/adc_8bit_buf.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/bsg_link_upstream_ctl.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/bsg_link_wrapper.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/chip_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/cnn_result_buf.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/ctrl_top.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/data_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/firmware_loader.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/i2c_init.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/instr_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/mux_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/pkt_framer.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/scan_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_aligner.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_alu.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_bufreg.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_bufreg2.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_compdec.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_csr.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_debug.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_decode.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_immdec.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_mem_if.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_rf_if.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_rf_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_rf_ram_if.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_rf_top.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_state.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/serv_top.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/spi_master.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/uart_peripheral.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/design/uart_tx.v
# BaseJump STL (ordered so each module comes before its users)
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/basejump/bsg_launch_sync_sync.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/basejump/bsg_async_ptr_gray.v
set_global_assignment -name SYSTEMVERILOG_FILE ../chip/rtl/basejump/bsg_scan.v
