# Chip board (two-board setup)

# device and top level
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY chip_fpga_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# SystemVerilog
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
# include folder
set_global_assignment -name SEARCH_PATH rtl/basejump

# unused pins are inputs
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

# timing
set_global_assignment -name SDC_FILE chip.sdc

# source files
# chip wrapper and TSMC stand-ins
set_global_assignment -name SYSTEMVERILOG_FILE chip_fpga_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE chip_leds.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../common/tsmc_fpga_models.sv
# chip RTL (Jun 6, unchanged)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/adc_8bit_buf.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/bsg_link_upstream_ctl.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/bsg_link_wrapper.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/chip_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/cnn_result_buf.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/ctrl_top.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/data_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/firmware_loader.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/i2c_init.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/instr_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/mux_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/pkt_framer.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/scan_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_aligner.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_alu.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_bufreg.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_bufreg2.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_compdec.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_csr.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_ctrl.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_debug.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_decode.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_immdec.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_mem_if.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_rf_if.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_rf_ram.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_rf_ram_if.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_rf_top.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_state.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/serv_top.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/spi_master.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/uart_peripheral.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/design/uart_tx.v
# BaseJump (each module before the ones that use it)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_launch_sync_sync.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_async_ptr_gray.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_scan.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_gray_to_binary.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_async_credit_counter.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_mem_1r1w_synth.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_mem_1r1w.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_async_fifo.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_circular_ptr.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_counter_clear_up.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_dff.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_dff_en.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_dff_reset.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_fifo_tracker.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_fifo_1r1w_small_unhardened.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_two_fifo.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_fifo_1r1w_small.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_iddr_phy.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_source_sync_downstream.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_one_fifo.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_round_robin_1_to_n.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_serial_in_parallel_out_full.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_ddr_downstream.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_oddr_phy.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_source_sync_upstream.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_parallel_in_serial_out.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_ddr_upstream.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_link_source_sync_upstream_sync.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_serial_in_parallel_out.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/basejump/bsg_sync_sync.v

# pins (DE1-SoC manual), all 3.3 V
# PAD n = GPIO_0[n] for n < 36, else GPIO_1[n-36]
set_location_assignment PIN_AC18 -to dn_data[0]
set_location_assignment PIN_Y17 -to dn_data[1]
set_location_assignment PIN_AD17 -to dn_data[2]
set_location_assignment PIN_Y18 -to dn_data[3]
set_location_assignment PIN_AK16 -to dn_data[4]
set_location_assignment PIN_AK18 -to dn_data[5]
set_location_assignment PIN_AK19 -to dn_data[6]
set_location_assignment PIN_AJ19 -to dn_data[7]
set_location_assignment PIN_AJ17 -to dn_clk
set_location_assignment PIN_AJ16 -to dn_valid
set_location_assignment PIN_AH18 -to dn_token
set_location_assignment PIN_AH17 -to scan_en
set_location_assignment PIN_AG16 -to token_clk
set_location_assignment PIN_AE16 -to spi_sclk
set_location_assignment PIN_AF16 -to up_valid
set_location_assignment PIN_AG17 -to up_clk
set_location_assignment PIN_AA18 -to up_data[6]
set_location_assignment PIN_AA19 -to up_data[7]
set_location_assignment PIN_AE17 -to up_data[4]
set_location_assignment PIN_AC20 -to up_data[5]
set_location_assignment PIN_AH19 -to up_data[2]
set_location_assignment PIN_AJ20 -to up_data[3]
set_location_assignment PIN_AH20 -to up_data[0]
set_location_assignment PIN_AK21 -to up_data[1]
set_location_assignment PIN_AD19 -to uart_rx
set_location_assignment PIN_AD20 -to spi_miso
set_location_assignment PIN_AE18 -to spi_cs_n
set_location_assignment PIN_AE19 -to uart_tx
set_location_assignment PIN_AF20 -to i2c_scl
set_location_assignment PIN_AF21 -to i2c_sda
set_location_assignment PIN_AB17 -to mux_row[0]
set_location_assignment PIN_AA21 -to mux_row[1]
set_location_assignment PIN_AB21 -to mux_row[2]
set_location_assignment PIN_AC23 -to mux_row[3]
set_location_assignment PIN_AD24 -to mux_col[0]
set_location_assignment PIN_AE23 -to mux_col[1]
set_location_assignment PIN_AE24 -to mux_col[2]
set_location_assignment PIN_AF25 -to mux_col[3]
set_location_assignment PIN_AF26 -to core_clk
set_location_assignment PIN_AG25 -to hard_reset
set_location_assignment PIN_AG26 -to scan_in
set_location_assignment PIN_AH24 -to scan_out
# switches
set_location_assignment PIN_AB12 -to SW[0]
set_location_assignment PIN_AC12 -to SW[1]
set_location_assignment PIN_AF9 -to SW[2]
set_location_assignment PIN_AF10 -to SW[3]
set_location_assignment PIN_AD11 -to SW[4]
set_location_assignment PIN_AD12 -to SW[5]
set_location_assignment PIN_AE11 -to SW[6]
set_location_assignment PIN_AC9 -to SW[7]
set_location_assignment PIN_AD10 -to SW[8]
set_location_assignment PIN_AE12 -to SW[9]
# LEDs
set_location_assignment PIN_V16 -to LEDR[0]
set_location_assignment PIN_W16 -to LEDR[1]
set_location_assignment PIN_V17 -to LEDR[2]
set_location_assignment PIN_V18 -to LEDR[3]
set_location_assignment PIN_W17 -to LEDR[4]
set_location_assignment PIN_W19 -to LEDR[5]
set_location_assignment PIN_Y19 -to LEDR[6]
set_location_assignment PIN_W20 -to LEDR[7]
set_location_assignment PIN_W21 -to LEDR[8]
set_location_assignment PIN_Y21 -to LEDR[9]

# all 3.3 V
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to core_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dn_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dn_data[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dn_token
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dn_valid
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hard_reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i2c_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i2c_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to mux_col[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to mux_row[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to scan_en
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to scan_in
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to scan_out
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to spi_cs_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to spi_miso
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to spi_sclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to token_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to up_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to up_data[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to up_valid
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[*]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
